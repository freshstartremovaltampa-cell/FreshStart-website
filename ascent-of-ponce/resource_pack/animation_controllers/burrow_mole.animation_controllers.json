{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ponce.burrow_mole": {
      "initial_state": "burrowed",
      "states": {
        "burrowed": {
          "animations": [
            "burrowed"
          ],
          "transitions": [
            {
              "emerged": "!query.property('ponce:burrowed')"
            }
          ]
        },
        "emerged": {
          "animations": [
            "walk",
            "emerged"
          ],
          "transitions": [
            {
              "burrowed": "query.property('ponce:burrowed')"
            }
          ]
        }
      }
    }
  }
}
