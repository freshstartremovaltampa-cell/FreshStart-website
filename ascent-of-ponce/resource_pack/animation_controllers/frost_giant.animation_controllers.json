{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ponce.frost_giant": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "transitions": [
            {
              "breath": "query.property('ponce:pose') == 1"
            },
            {
              "slam": "query.property('ponce:pose') == 2"
            }
          ]
        },
        "breath": {
          "animations": [
            "breath"
          ],
          "transitions": [
            {
              "idle": "query.property('ponce:pose') != 1"
            }
          ]
        },
        "slam": {
          "animations": [
            "slam"
          ],
          "transitions": [
            {
              "idle": "query.property('ponce:pose') != 2"
            }
          ]
        }
      }
    }
  }
}
