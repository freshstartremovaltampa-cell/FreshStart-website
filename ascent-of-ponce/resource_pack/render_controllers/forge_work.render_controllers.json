{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.ponce.forge_work": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "overlay_color": {
        "r": "query.property('ponce:heat') == 1 ? 0.8 : 1.0",
        "g": "query.property('ponce:heat') == 1 ? 0.1 : (query.property('ponce:heat') == 2 ? 0.45 : (query.property('ponce:heat') == 3 ? 0.85 : 1.0))",
        "b": "query.property('ponce:heat') == 4 ? 0.9 : (query.property('ponce:heat') == 3 ? 0.2 : 0.05)",
        "a": "query.property('ponce:heat') == 0 ? 0.0 : 0.3 + query.property('ponce:heat') * 0.1"
      },
      "is_hurt_color": {},
      "on_fire_color": {}
    }
  }
}
